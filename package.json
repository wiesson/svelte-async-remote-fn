{
	"name": "svelte-async-remote-fn",
	"version": "1.0.0",
	"description": "Interactive showcase of SvelteKit Remote Functions patterns - query, command, and form patterns with live examples",
	"type": "module",
	"keywords": [
		"sveltekit",
		"svelte",
		"remote-functions",
		"async",
		"demo",
		"query",
		"command",
		"form",
		"shadcn-svelte",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/wiesson/svelte-async-remote-fn"
	},
	"bugs": {
		"url": "https://github.com/wiesson/svelte-async-remote-fn/issues"
	},
	"homepage": "https://svelte-async-remote-fn.vercel.app",
	"license": "MIT",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt",
		"lint": "vp lint",
		"check:fix": "vp check --fix"
	},
	"devDependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.76.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"clsx": "^2.1.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"satori": "^0.63.2",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
